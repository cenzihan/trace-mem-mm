# Allow-list the build context. Never include experiments, data, keys or Git history.
**
!Dockerfile
!.dockerignore
!agent_memory/
!agent_memory/**
!deploy/
deploy/**
!deploy/*.py
!deploy/docker/
deploy/docker/**
!deploy/docker/Dockerfile.mem0
!deploy/docker/requirements-docker.txt
!deploy/docker/requirements-mem0.txt
**/__pycache__/
**/*.pyc
**/*.sqlite*
**/*.key
**/*.pem
**/.env*
