FROM python:3.11-slim-bookworm@sha256:f06d01d4ba3f8ad5af45a3ec87df19c1d317d8e8961edc0fabda61811af6f7cf
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MEM0_TELEMETRY=false
WORKDIR /app
ARG PIP_FIND_LINKS
ARG PIP_NO_INDEX=0
COPY requirements-docker.txt requirements-mem0.txt /app/
RUN pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements-docker.txt -r requirements-mem0.txt \
    && groupadd --gid 10001 tracemem \
    && useradd --uid 10001 --gid 10001 --no-create-home tracemem \
    && mkdir -p /data /app/runtime && chown 10001:10001 /data /app/runtime
COPY agent_memory/ /app/agent_memory/
COPY deploy/ /app/deploy/
USER 10001:10001
EXPOSE 8000
CMD ["gunicorn", "--config", "/app/deploy/gunicorn.conf.py", "agent_memory.mem0_app:create_app()"]
